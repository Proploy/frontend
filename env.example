# ===========================================
# Supabase Authentication (Primary)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://eczlamdmamicyugklabj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.eczlamdmamicyugklabj.supabase.co:5432/postgres

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Admin access
ADMIN_EMAILS=

# Rate Limiting - Upstash Redis (Optional, for production)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Revalidation Configuration (in seconds)
REVALIDATE_TIME=3600

# ===========================================
# Proploy service-apis gateway (downstream)
# ===========================================
# Base URL for the FastAPI service-apis layer that fronts catalog + agent.
# Leave empty in dev to fall back to mock data.
SERVICE_APIS_BASE_URL=http://127.0.0.1:8020
