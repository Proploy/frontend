SERVICE_APIS_BASE_URL=https://service-apis-731353524841.australia-southeast1.run.app


# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Public — safe to expose in the browser bundle and in netlify.toml.
# Find the project ID at https://sanity.io/manage (project overview / the URL).
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Pin this. Sanity treats the API version as a date-based contract; leaving it
# floating means a future API change can alter query results without a deploy.
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# Server-only — MUST NOT be prefixed NEXT_PUBLIC_ and MUST NOT go in
# netlify.toml (set it in the Netlify UI instead).
# Create at sanity.io/manage -> API -> Tokens -> Add API token.
# Scope: Viewer. Not Editor/Admin — Visual Editing forwards this token to the
# browser while draft mode is active, so it must be read-only.
SANITY_API_READ_TOKEN=your_sanity_viewer_token

# Server-only — shared secret guarding /api/draft-mode/enable so that only
# Sanity Studio can flip a visitor into draft mode. Generate a fresh random
# value:  openssl rand -hex 32
SANITY_PREVIEW_SECRET=your_random_preview_secret
